[
  {
    "topic": "homeassistant/select/kotel_ray_rezim/config",
    "payload": {
      "name": "Kotel rezim",
      "unique_id": "kotel_ray_rezim",
      "options": [
        "auto",
        "off",
        "heat",
        "water"
      ],
      "command_topic": "ebusd/bai/SetMode/set",
      "command_template": "{% if value == 'water' %}3;50;{{ states('number.protherm_ray_kotel_tuv_teplota') | int(65) }};50;0;0;0;0;0;0;0;0{% elif value == 'heat' %}2;50;50;{{ states('number.protherm_ray_kotel_teplota_topeni') | int(50) }};0;0;0;0;0;0;0;0{% elif value == 'off' %}1;50;50;50;0;0;0;0;0;0;0;0{% else %}0;50;50;50;0;0;0;0;0;0;0;0{% endif %}",
      "device": {
        "identifiers": [
          "ebusd_bai"
        ]
      },
      "state_topic": "ebusd/bai/Status02",
      "value_template": "{{ (value_json['hwcmode'].value if 'hwcmode' in value_json else value_json['hcmode'].value) | lower }}"
    }
  },
  {
    "topic": "homeassistant/number/kotel_ray_tuv/config",
    "payload": {
      "name": "Kotel TUV teplota",
      "unique_id": "kotel_ray_tuv",
      "command_topic": "ebusd/bai/SetMode/set",
      "command_template": "water;50;{{ value }};50;0;0;0;0;0;0;0;0",
      "min": 35,
      "max": 70,
      "step": 1,
      "device": {
        "identifiers": [
          "ebusd_bai"
        ]
      },
      "mode": "box",
      "state_topic": "ebusd/bai/SetMode",
      "value_template": "{{ value_json['hwctempdesired'].value }}"
    }
  },
  {
    "topic": "homeassistant/number/kotel_ray_topeni/config",
    "payload": {
      "name": "Kotel teplota topeni",
      "unique_id": "kotel_ray_topeni",
      "command_topic": "ebusd/bai/SetMode/set",
      "command_template": "heat;{{ value }};50;50;0;0;0;0;0;0;0;0",
      "min": 30,
      "max": 80,
      "step": 1,
      "device": {
        "identifiers": [
          "ebusd_bai"
        ]
      },
      "mode": "box",
      "state_topic": "ebusd/bai/SetMode",
      "value_template": "{{ value_json['flowtempdesired'].value }}"
    }
  }
]
